# Published-to-web CSV URL of the "Sessions" tab
# (Google Sheet -> File -> Share -> Publish to web -> Sessions tab -> CSV)
SESSIONS_CSV_URL=

# Google Apps Script web-app URL (see ../apps-script/README.md). Server-only.
APPS_SCRIPT_URL=
# Must match the SECRET script property set in Apps Script
APPS_SCRIPT_SECRET=
NEXT_PUBLIC_SITE_URL=
